# OAuth2 client credentials issued by Hammerhead when you register an API client.
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=

# How often to poll Hammerhead for new activities, in seconds.
# 1800 = 30 minutes, chosen to keep load on Hammerhead's API low.
HAMMERHEAD_POLL_INTERVAL=1800

# Only needed if you're pointing at a non-production Hammerhead environment.
# HAMMERHEAD_API_BASE_URL=https://api.hammerhead.io/v1/api
# HAMMERHEAD_AUTH_BASE_URL=https://api.hammerhead.io/v1/auth

# Note: the watch folder and state/token storage locations are NOT
# configured here. They're fixed inside the container (see config.py) and
# mapped to host folders via the `volumes:` section of docker-compose.yml
# instead -- see the "Persistent storage layout" section in README.md.
