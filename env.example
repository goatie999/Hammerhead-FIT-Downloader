# OAuth2 client credentials issued by Hammerhead when you register an API client.
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=

# Folder Dreeve watches for new activity files. Stays at the root, alongside
# (not inside) the hammerhead/ folder below.
DREEVE_WATCH_FOLDER=/data/dreeve/watch

# Where this connector persists its sync cursor (which activities are
# already downloaded). Bind-mounted from ./hammerhead/state on the host.
HAMMERHEAD_STATE_DIR=/data/hammerhead/state

# Where this connector persists its OAuth tokens. Bind-mounted from
# ./hammerhead/tokens on the host. Kept separate from state so you can back
# up or lock down the two independently.
HAMMERHEAD_TOKEN_DIR=/data/hammerhead/tokens

# How often to poll Hammerhead for new activities, in seconds.
# 1800 = 30 minutes, chosen to keep load on Hammerhead's API low.
POLL_INTERVAL_SECONDS=1800

# Only needed if you're pointing at a non-production Hammerhead environment.
# HAMMERHEAD_API_BASE_URL=https://api.hammerhead.io/v1/api
# HAMMERHEAD_AUTH_BASE_URL=https://api.hammerhead.io/v1/auth
